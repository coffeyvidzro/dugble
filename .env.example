# Dugble Docker deployment environment
#
# Copy this file to .env on the deployment host:
#   cp .env.example .env
#
# Never commit the populated .env file.

# Application
APP_ENV=production
API_DOMAIN=api.dugble.com
BACKOFFICE_DOMAIN=bo.dugble.com
FRONTEND_URL=https://dugble.com
BACKEND_URL=https://api.dugble.com
CORS_ORIGINS=https://dugble.com
COOKIE_DOMAIN=dugble.com

# Private Identity AI service
IDENTITY_AI_API_KEY=replace-with-a-separate-long-random-secret
IDENTITY_AI_TIMEOUT=30s

# PostgreSQL
POSTGRES_USER=dugble
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=dugble

# NATS JetStream, transactional outbox, and SMS delivery consumer
NATS_USER=dugble
NATS_PASSWORD=replace-with-a-separate-long-random-password
NATS_OUTBOX_POLL_INTERVAL=500ms
NATS_OUTBOX_BATCH_SIZE=100
NATS_OUTBOX_LOCK_TIMEOUT=30s
NATS_SMS_CONSUMER_CONCURRENCY=10
NATS_SMS_CONSUMER_ACK_WAIT=2m
NATS_SMS_CONSUMER_MAX_DELIVER=6
NATS_SMS_HANDLER_TIMEOUT=45s

# Outgoing webhook delivery worker
WEBHOOK_DELIVERY_POLL_INTERVAL=500ms
WEBHOOK_DELIVERY_BATCH_SIZE=50
WEBHOOK_DELIVERY_CONCURRENCY=10
WEBHOOK_DELIVERY_LOCK_TIMEOUT=30s
WEBHOOK_DELIVERY_HANDLE_TIMEOUT=15s
WEBHOOK_DELIVERY_HTTP_TIMEOUT=10s
WEBHOOK_DELIVERY_AUTO_DISABLE_AFTER=20

# Arcjet request protection
ARCJET_KEY=replace-with-your-arcjet-key

# AWS SES transactional email
AWS_FROM_EMAIL=hello@dugble.com
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-your-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-your-secret-access-key

# Backoffice access (comma-separated)
BACKOFFICE_ADMIN_EMAILS=admin@dugble.com

# Arkesel SMS (optional until enabled)
ARKESEL_BASE_URL=https://sms.arkesel.com
ARKESEL_API_KEY=

# mNotify SMS (optional until enabled)
MNOTIFY_BASE_URL=https://api.mnotify.com
MNOTIFY_API_KEY=

# Hubtel payments (optional until enabled)
HUBTEL_API_ID=
HUBTEL_API_KEY=
HUBTEL_MERCHANT_NUMBER=
