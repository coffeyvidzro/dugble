# Dugble Docker deployment environment
#
# Copy this file to .env on the deployment host:
#   cp .env.example .env
#
# Never commit the populated .env file.

# Core application
APP_ENV=production
API_DOMAIN=api.dugble.com
BACKOFFICE_DOMAIN=bo.dugble.com
FRONTEND_URL=https://dugble.com
BACKEND_URL=https://api.dugble.com
CORS_ORIGINS=https://dugble.com,https://www.dugble.com
COOKIE_DOMAIN=dugble.com
HTTP_PORT=8080
BACKOFFICE_HTTP_PORT=8081

# PostgreSQL (used by Docker Compose)
POSTGRES_USER=dugble
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=dugble

# NATS (used by Docker Compose)
NATS_USER=dugble
NATS_PASSWORD=replace-with-a-separate-long-random-password

# Security and encryption
# Valid 32-byte base64 fixture for local/CI startup only. Replace before deployment.
ENCRYPTION_KEYS=2026-01:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Independent random secret used to authenticate verification codes. Use at least 32 characters.
VERIFY_HMAC_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
# Deprecated single-key fallback; remove after all ciphertext has been rotated.
MFA_ENCRYPTION_KEY=

# Request protection
ARCJET_KEY=replace-with-your-arcjet-key

# AWS SES transactional email
AWS_FROM_EMAIL=hello@dugble.com
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-your-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-your-secret-access-key
AWS_SES_CONFIGURATION_SET=dugble-transactional
AWS_SNS_TOPIC_ARNS=arn:aws:sns:us-east-1:123456789012:dugble-ses-events

# Backoffice access
BACKOFFICE_ADMIN_EMAILS=admin@dugble.com

# SMS providers (optional until enabled)
ARKESEL_BASE_URL=https://sms.arkesel.com
ARKESEL_API_KEY=
MNOTIFY_BASE_URL=https://api.mnotify.com
MNOTIFY_API_KEY=

# Observability
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true
NEW_RELIC_LOG_ENABLED=true

SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_ERROR_SAMPLE_RATE=1
SENTRY_DEBUG=false

# Hubtel payments (optional until enabled)
