# Dugble Docker deployment environment
#
# Copy this file to .env on the deployment host:
#   cp .env.example .env
#
# Never commit the populated .env file.

# Application
APP_ENV=production
API_DOMAIN=api.dugble.com
BACKOFFICE_DOMAIN=bo.dugble.com
FRONTEND_URL=https://dugble.com
BACKEND_URL=https://api.dugble.com
CORS_ORIGINS=https://dugble.com
COOKIE_DOMAIN=dugble.com

# PostgreSQL
POSTGRES_USER=dugble
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=dugble

# Arcjet request protection
ARCJET_KEY=replace-with-your-arcjet-key

# AWS SES transactional email
AWS_FROM_EMAIL=hello@dugble.com
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-your-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-your-secret-access-key

# Backoffice access (comma-separated)
BACKOFFICE_ADMIN_EMAILS=admin@dugble.com

# Arkesel SMS (optional until enabled)
ARKESEL_BASE_URL=https://sms.arkesel.com
ARKESEL_API_KEY=

# mNotify SMS (optional until enabled)
MNOTIFY_BASE_URL=https://api.mnotify.com
MNOTIFY_API_KEY=

# Hubtel payments (optional until enabled)
HUBTEL_API_ID=
HUBTEL_API_KEY=
HUBTEL_MERCHANT_NUMBER=
