# Application
APP_ENV=development
API_DOMAIN=localhost
FRONTEND_URL=http://localhost:3000

# Datastore
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dugble?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Docker Compose database defaults
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dugble

# Browser/API security
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Arcjet protection
ARCJET_KEY=

# AWS SES email
AWS_FROM_EMAIL=hello@example.com
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Hubtel payments
HUBTEL_BASE_URL=https://payproxyapi.hubtel.com
HUBTEL_API_ID=
HUBTEL_API_KEY=
HUBTEL_MERCHANT_ACCOUNT_NUMBER=
HUBTEL_CALLBACK_URL=http://localhost:8080/wallet/webhook/hubtel
HUBTEL_RETURN_URL=http://localhost:3000/dashboard/usage
HUBTEL_CANCELLATION_URL=http://localhost:3000/dashboard/usage
