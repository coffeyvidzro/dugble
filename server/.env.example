# Application
APP_ENV=development
HTTP_PORT=8080
API_DOMAIN=localhost
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080

# Backoffice
BACKOFFICE_HTTP_PORT=8081
BACKOFFICE_ADMIN_EMAILS=admin@example.com

# Datastore
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dugble?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Docker Compose database defaults
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dugble

# Browser/API security
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_DOMAIN=

# Arcjet protection
ARCJET_KEY=

# AWS SES email
AWS_FROM_EMAIL=hello@example.com
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Arkesel SMS
ARKESEL_BASE_URL=https://sms.arkesel.com
ARKESEL_API_KEY=

# mNotify SMS
MNOTIFY_BASE_URL=https://api.mnotify.com
MNOTIFY_API_KEY=

# Hubtel payments
HUBTEL_API_ID=
HUBTEL_API_KEY=
HUBTEL_MERCHANT_NUMBER=

# NATS JetStream
NATS_URL=nats://localhost:4222

# Identity AI
IDENTITY_AI_ENABLED=false
IDENTITY_AI_BASE_URL=http://localhost:8000
IDENTITY_AI_API_KEY=replace-with-a-long-random-secret
IDENTITY_AI_TIMEOUT=5s
