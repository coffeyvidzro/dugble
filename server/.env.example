# Application
APP_ENV=development
HTTP_PORT=8080
API_DOMAIN=localhost
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080

# Backoffice
BACKOFFICE_HTTP_PORT=8081
BACKOFFICE_ADMIN_EMAILS=admin@example.com

# Datastore
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dugble?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Docker Compose database defaults
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dugble

# Browser/API security
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_DOMAIN=

# Arcjet protection
ARCJET_KEY=

# AWS SES email
AWS_FROM_EMAIL=hello@example.com
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Arkesel SMS
ARKESEL_BASE_URL=https://sms.arkesel.com
ARKESEL_API_KEY=

# mNotify SMS
MNOTIFY_BASE_URL=https://api.mnotify.com
MNOTIFY_API_KEY=

# Hubtel payments
HUBTEL_API_ID=
HUBTEL_API_KEY=
HUBTEL_MERCHANT_NUMBER=

# NATS JetStream, transactional outbox, SMS delivery consumer, and email delivery consumer
NATS_URL=nats://localhost:4222
NATS_OUTBOX_POLL_INTERVAL=500ms
NATS_OUTBOX_BATCH_SIZE=100
NATS_OUTBOX_LOCK_TIMEOUT=30s
NATS_SMS_CONSUMER_CONCURRENCY=10
NATS_SMS_CONSUMER_ACK_WAIT=2m
NATS_SMS_CONSUMER_MAX_DELIVER=6
NATS_SMS_HANDLER_TIMEOUT=45s
NATS_EMAIL_CONSUMER_CONCURRENCY=5
NATS_EMAIL_CONSUMER_ACK_WAIT=2m
NATS_EMAIL_CONSUMER_MAX_DELIVER=6
NATS_EMAIL_HANDLER_TIMEOUT=45s

# Outgoing webhook delivery worker
WEBHOOK_DELIVERY_POLL_INTERVAL=500ms
WEBHOOK_DELIVERY_BATCH_SIZE=50
WEBHOOK_DELIVERY_CONCURRENCY=10
WEBHOOK_DELIVERY_LOCK_TIMEOUT=30s
WEBHOOK_DELIVERY_HANDLE_TIMEOUT=15s
WEBHOOK_DELIVERY_HTTP_TIMEOUT=10s
WEBHOOK_DELIVERY_AUTO_DISABLE_AFTER=20


# Identity AI
IDENTITY_AI_ENABLED=false
IDENTITY_AI_BASE_URL=http://identity-ai:8000
IDENTITY_AI_API_KEY=replace-with-a-long-random-secret
IDENTITY_AI_GUIDANCE_TIMEOUT=3s
IDENTITY_AI_ANALYSIS_TIMEOUT=30s
IDENTITY_AI_MAX_RESPONSE_SIZE=1048576
IDENTITY_VERIFICATION_TTL=5m
IDENTITY_CAPTURE_TOKEN_TTL=2m
IDENTITY_MAX_ATTEMPTS=3
IDENTITY_POLICY_VERSION=identity-default-v1
IDENTITY_ATTACK_THRESHOLD=0.6
IDENTITY_FACE_SIMILARITY_THRESHOLD=0.6
