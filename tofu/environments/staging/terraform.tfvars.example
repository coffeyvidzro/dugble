environment                         = "staging"
region                              = "eu-central"
network_cidr                        = "10.20.0.0/16"
server_instance_size                = "medium"
server_replicas                     = 1
server_container_image              = "ghcr.io/dugble/server:staging"
database_instance_size              = "medium"
database_version                    = "17"
database_backup_retention_days      = 7
redis_instance_size                 = "medium"
redis_high_availability             = false
storage_retention_days              = 30
storage_versioning_enabled          = true
identity_container_image            = "ghcr.io/dugble/identity:staging"
identity_cpu                        = 2
identity_memory_mb                  = 4096
identity_gpu_enabled                = false
