environment                         = "production"
network_cidr                        = "10.30.0.0/16"
server_instance_size                = "large"
server_replicas                     = 2
server_container_image              = "ghcr.io/dugble/server:production"
database_instance_size              = "large"
database_version                    = "17"
database_backup_retention_days      = 35
redis_instance_size                 = "large"
redis_high_availability             = true
r2_retention_days                   = 90
r2_location                         = "WEUR"
vercel_project_name                 = "dugble-production"
vercel_root_directory               = "web"
vercel_production_branch            = "main"
vercel_domains                      = []
identity_container_image            = "ghcr.io/dugble/identity:production"
identity_cpu                        = 4
identity_memory_mb                  = 8192
identity_gpu_enabled                = false
