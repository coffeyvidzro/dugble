# Copy to .env.local for development. Never commit real values.

# Server-only: origin of the Go API. Browser requests reach it through the
# same-origin /api/v1/* rewrite in next.config.ts, so it is never exposed.
BACKEND_URL=http://localhost:8080

# Public: canonical origin of this Next.js app (used for metadata/OG URLs).
NEXT_PUBLIC_BASE_URL=http://localhost:3000
